# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용한다. (.env 는 git 에 커밋되지 않음)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=image_be
MYSQL_USER=image_be
MYSQL_PASSWORD=change-me

DATABASE_URL=mysql+pymysql://image_be:change-me@127.0.0.1:3306/image_be?charset=utf8mb4

# true 로 두면 실행되는 SQL 을 콘솔에 출력한다.
SQL_ECHO=false
