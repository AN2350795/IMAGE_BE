FROM mcr.microsoft.com/devcontainers/python:3.12

# uv 는 공식 배포 이미지에서 바이너리만 가져온다. 태그를 고정해 두어야
# 이미지를 다시 빌드해도 모든 머신에서 같은 uv 가 들어간다.
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /usr/local/bin/

# 가상환경을 워크스페이스 밖에 둔다. 바인드 마운트된 폴더 안에 두면
# 호스트의 .venv 와 충돌하고, 윈도우에서는 I/O 가 크게 느려진다.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH

# 이 경로들은 named volume 의 마운트 지점이다. 이미지 안에 미리 만들어 두어야
# 볼륨이 root 가 아니라 vscode 소유로 초기화된다.
RUN mkdir -p /opt/venv /opt/uv-cache && chown vscode:vscode /opt/venv /opt/uv-cache

USER vscode
